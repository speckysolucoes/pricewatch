# .env.example — Fase 4
# cp .env.example .env

APP_NAME="Price Monitor Bot"
DEBUG=false
BASE_URL=https://seudominio.com

DATABASE_URL=sqlite:///./price_monitor.db
CHECK_INTERVAL_MINUTES=30

AMAZON_AFFILIATE_TAG=seutag-20

# USE_MOCK=true  ← preços simulados (dev)

# ── JWT ──────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=TROQUE_ISSO_EM_PRODUCAO

# ── TELEGRAM ─────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=

# ── PAGAMENTOS ───────────────────────────────────────────
# Configure UM dos gateways abaixo (ou nenhum para usar Mock)

# Mercado Pago (recomendado para BR)
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
# MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxx
# MERCADOPAGO_WEBHOOK_SECRET=sua_chave_secreta

# Stripe (global)
# Obtenha em: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Preços (em centavos)
PLAN_PREMIUM_PRICE_BRL=1900   # R$ 19,00
PLAN_PREMIUM_PRICE_USD=499    # US$ 4,99
